{
  "name": "neo-arcade",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:gh": "gh-pages -d dist",
    "auto": "node scripts/auto-push.js",
    "watch": "node scripts/auto-push.js",
    "dev:auto": "vite & node scripts/auto-push.js",
    "dashboard": "node scripts/terminal-dashboard.js",
    "dev:sync": "vite & node scripts/terminal-dashboard.js",
    "preview:sync": "vite preview & node scripts/terminal-dashboard.js",
    "stats": "node -e \"import('fs').then(fs=>{console.log(fs.readFileSync('arcade-stats.json','utf-8'))})\"",
    "stats:watch": "node scripts/terminal-dashboard.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
